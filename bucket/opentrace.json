        ]
    ],
    "shortcuts": [
        [
            "OpenTrace.exe",
            "OpenTrace"
        ]
    ],
    "persist": "OpenTrace.pdb",
    "checkver": {
        "github": "https://github.com/Archeb/opentrace"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://v6.gh-proxy.org/https://github.com/Archeb/opentrace/releases/download/v$version/win-x64.zip"
            }
        }
    }
